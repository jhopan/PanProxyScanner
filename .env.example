# Konfigurasi Pan Proxy Scanner (salin jadi .env lalu sesuaikan)
#
# Semua nilai opsional. Urutan prioritas: .env > flag CLI > settings.json
# (settings.json diubah dari halaman Scheduler; nilai di .env akan menimpanya setiap start).

# ------------------------------------------------------------------ listen / jaringan
# Host + port tempat panel mendengarkan.
#   PS_BIND_LAN=true  -> 0.0.0.0 (bisa diakses dari LAN)
#   PS_BIND_LAN=false -> 127.0.0.1 (hanya mesin ini, aman kalau dipakai bersama CF Tunnel)
PS_BIND_LAN=true
PS_HOST=0.0.0.0
PS_PORT=8787
# Alamat lengkap; kalau diisi, menang atas PS_HOST/PS_PORT/PS_BIND_LAN di atas.
# PS_ADDR=0.0.0.0:8787

# ------------------------------------------------------------------ berkas
PS_DB=proxies.db
# PS_CONFIG=C:/Users/ACER/.pan-proxy-scanner/settings.json

# ------------------------------------------------------------------ akun panel
PS_ADMIN_USER=admin
PS_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------ API untuk klien mesin
# Kalau diisi, /api/* wajib header X-Api-Token atau ?token=
# PS_API_TOKEN=ganti-token-ini

# ------------------------------------------------------------------ Cloudflare Tunnel
PS_TUNNEL_NAME=pan-proxy-scanner
PS_TUNNEL_DOMAIN=
PS_PUBLIC_URL=

# ------------------------------------------------------------------ siklus scraping
PS_AUTO=false
PS_INTERVAL_MINUTES=30
PS_CAP=20000
PS_JOBS=150
PS_MIN_SOURCES=0
PS_FRESH_MINUTES=360
